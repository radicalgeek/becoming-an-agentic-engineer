  "verification": {
    "command": "test:contract",
    "storeOnlyAfterExitCode": 0
  },
  "store": {
    "tool": "memory",
    "operation": "create",
    "category": "projects",
    "include": ["verified result", "evidence command", "source paths", "unresolved risks"],
    "exclude": ["scratch reasoning", "raw transcript", "secrets", "unverified claims"],
    "metadata": {
      "project": "accounts-api",
      "source": "course-rembr-memory-cycle"
    }
  },
  "harnessAdapters": {
    "claudeCode": ["SessionStart recall", "UserPromptSubmit capture"],
    "openClaw": ["before_prompt_build recall", "agent_end capture"],
    "openCode": ["session-start recall", "session-idle summary"],
    "codex": ["MCP search/memory tools", "rembr-memory skill policy"]
  }
}
