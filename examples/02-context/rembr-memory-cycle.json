{
  "project": "accounts-api",
  "task": "Add registration validation without changing login behaviour",
  "recall": {
    "tool": "search",
    "operation": "query",
    "query": "accounts-api registration validation login protected behaviour decisions",
    "strategy": "hybrid",
    "limit": 5,
    "minimumSimilarity": 0.7,
    "treatAs": "untrusted historical context"
  },
  "contextBudget": {
    "maximumMemories": 5,
    "maximumCharacters": 2400,
    "currentSourcesWin": ["spec/registration-validation.md", "tests/login-regression.test.js"]
